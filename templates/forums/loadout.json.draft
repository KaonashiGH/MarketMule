{
  "id": "loadout",
  "name": "Loadout",
  "type_tag": "Loadout",
  "id_prefix": "LOAD",
  "color": "#d08a2e",
  "title_format": "[Loadout] - {theme} - {budget}",

  "panel": {
    "thread_name": "Start here: Loadout help",
    "title": "🎨 Loadout Lab",
    "text": "Need help finishing a loadout? Build it in the **CSFloat Loadout Lab** first, then click **Post a loadout** and paste its Share URL.\n\nTell the community what you're going for and what you need solved. Your post is titled `[Loadout] - Theme - Budget`.",
    "button_label": "Post a loadout",
    "button_style": "success"
  },

  "pages": [
    {
      "name": "Your loadout",
      "title": "Loadout Lab",
      "fields": [
        {"key": "theme", "label": "Primary theme or color", "max_length": 40,
         "description": "Your post will be titled: [Loadout] - Theme - Budget",
         "placeholder": "Black & Gold"},
        {"key": "budget", "label": "Total budget", "max_length": 20,
         "placeholder": "$1,500"},
        {"key": "link", "label": "Loadout Lab share link", "max_length": 300,
         "description": "Build your inventory in CSFloat Loadout Lab, then paste the Share URL it generates.",
         "placeholder": "Paste your Share URL here"},
        {"key": "vision", "label": "Your vision for the loadout", "style": "paragraph", "max_length": 1000,
         "description": "What are you going for? Matching an Agent? Building around a pair of gloves?",
         "placeholder": "I'm building around ... and want everything to match ..."},
        {"key": "question", "label": "What do you need help with? (optional)", "style": "paragraph", "max_length": 1000, "required": false,
         "description": "Clearly state what you need the community to solve.",
         "placeholder": "Which AK would fit best for under $300?"}
      ]
    }
  ],

  "header": ["budget"],
  "style": "card",
  "thumbnail": true,
  "banner": "loadout",
  "icon": "mm_loadout",
  "card_title": "{theme}",
  "link_button": {"key": "link", "label": "Open in Loadout Lab"},
  "sections": [
    {"heading": "Vision", "body": "> {vision}"},
    {"heading": "What I need help with", "body": "> {question}"}
  ],
  "credit": "Posted by",

  "statuses": ["Open", "Solved", "Closed"],
  "final_statuses": ["Closed"],
  "tag_emojis": {"Loadout": "🎨", "Open": "🔵", "Solved": "🟢", "Closed": "⚫"},
  "reactions": [],

  "rating": {
    "title": "LOADOUT LAB RATING",
    "button_label": "Rate this loadout",
    "emoji": "⭐",
    "categories": [
      {"key": "color", "label": "Color Cohesion",
       "description": "Do the knife, gloves, and primary weapons actually match?"},
      {"key": "budget", "label": "Budget Efficiency",
       "description": "Did you get the best bang for your buck?"},
      {"key": "originality", "label": "Originality",
       "description": "Is this a unique theme, or just another boring full-red inventory?"},
      {"key": "stickers", "label": "Sticker Synergy",
       "description": "Do the stickers match the skin's artwork?"}
    ],
    "note": {"label": "Critic's Note",
             "placeholder": "e.g. Drop the Crimson Web gloves for Moto Gloves | Blood Pressure to stay under budget."},
    "leaderboard_min": 3
  }
}
