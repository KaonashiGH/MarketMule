{
  "id": "bug_report",
  "name": "Bug report",
  "type_tag": "Bug",
  "id_prefix": "BUG",
  "color": "#b83d32",
  "title_format": "[{area}] - {summary}",

  "panel": {
    "thread_name": "Start here: Report a bug",
    "title": "How to report a bug",
    "text": "Found something broken on CSFloat? Click **Report a bug** below.\n\nThe form has three short steps:\n**1. The bug:** what's broken and how to make it happen\n**2. Your setup:** platform, extension, browser and account details\n**3. Screenshots:** optional, but they help us fix it much faster\n\nYour post is titled `[Area] - Short description`, tagged, and posted here for the team. One bug per report, please.",
    "button_label": "Report a bug",
    "button_style": "danger"
  },

  "pages": [
    {
      "name": "The bug",
      "title": "Bug Report (1/3): The bug",
      "fields": [
        {"key": "area", "type": "select", "tag": true, "label": "Area of the site",
         "options": ["Marketplace", "Trading", "Chrome Extension", "Database", "Account", "Other"]},
        {"key": "summary", "label": "Short description", "max_length": 75,
         "description": "Becomes your title: [Area] - Short description",
         "placeholder": "Float values overlap item names on Steam inventory"},
        {"key": "description", "label": "1. Description of the bug", "style": "paragraph", "max_length": 1000,
         "placeholder": "What is broken, and where on the site?"},
        {"key": "steps", "label": "2. Steps to reproduce", "style": "paragraph", "max_length": 1000,
         "placeholder": "1. Open...\n2. Click...\n3. See..."},
        {"key": "expected_actual", "label": "3. Expected vs. actual behavior", "style": "paragraph", "max_length": 800,
         "placeholder": "Expected: ...\nActual: ..."}
      ]
    },
    {
      "name": "Your setup",
      "title": "Bug Report (2/3): Your setup",
      "fields": [
        {"key": "platform", "type": "select", "label": "Platform",
         "options": ["Web Desktop", "Web Mobile", "Mobile App"]},
        {"key": "extension", "type": "select", "label": "Extension installed?",
         "options": ["Yes (Chrome)", "Yes (Firefox)", "No"]},
        {"key": "browser_os", "label": "Browser & OS", "max_length": 100,
         "placeholder": "Chrome 118, Windows 11"},
        {"key": "steam_link", "label": "Steam profile link (optional)", "max_length": 200, "required": false,
         "placeholder": "https://steamcommunity.com/id/..."},
        {"key": "trade_ref", "label": "Trade ID or item float (optional)", "max_length": 100, "required": false,
         "placeholder": "Leave empty if it doesn't apply"}
      ]
    },
    {
      "name": "Screenshots",
      "title": "Bug Report (3/3): Screenshots",
      "fields": [
        {"type": "note",
         "text": "### Got a screenshot or recording?\nIt's the fastest way for us to see the bug. **Not required.** Leave it empty and press **Submit** to post without one."},
        {"key": "evidence", "type": "file", "label": "6. Visual evidence (optional)", "required": false, "max": 10,
         "description": "Screenshots or a short screen recording"},
        {"key": "category", "type": "select", "tag": true, "label": "Category (optional)", "required": false, "max": 2,
         "placeholder": "Pick up to 2, or skip",
         "options": ["UI/UX", "Performance", "Functionality"]}
      ]
    }
  ],

  "sections": [
    {"heading": "1. Description of the Bug", "body": "{description}"},
    {"heading": "2. Steps to Reproduce", "body": "{steps}"},
    {"heading": "3. Expected vs. Actual Behavior", "body": "{expected_actual}"},
    {"heading": "4. Setup Details", "body": "**Platform:** {platform}\n**Extension Installed?** {extension}\n**Browser & OS:** {browser_os}"},
    {"heading": "5. Account & Trade Details", "body": "**Your Steam Profile Link:** {steam_link}\n**Trade ID or Item Float:** {trade_ref}"},
    {"heading": "6. Visual Evidence", "body": "{attachments}"}
  ],

  "statuses": ["Open", "In progress", "Fixed", "Denied", "Duplicate", "Closed"],
  "final_statuses": ["Fixed", "Denied", "Duplicate", "Closed"],
  "tag_emojis": {
    "Bug": "🐞",
    "Open": "🔵", "In progress": "🟡", "Fixed": "🟢", "Denied": "🔴", "Duplicate": "⚪", "Closed": "⚫"
  },
  "reactions": []
}
