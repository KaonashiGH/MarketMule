{
  "id": "bug_report",
  "name": "Bug report",
  "type_tag": "Bug",
  "id_prefix": "BUG",
  "color": "#b83d32",
  "title_format": "[{status}] - {area} · {summary}",

  "panel": {
    "thread_name": "Start here: Report a bug",
    "title": "How to report a bug",
    "text": "Found something broken on CSFloat? Click **Report a bug** below.\n\nThe form has three short steps:\n**1. The bug:** what's broken and how to make it happen\n**2. Your setup:** platform, extension, browser and account details\n**3. Screenshots:** optional, but they help us fix it much faster\n\nYour post is titled with its status, the area and your short description, tagged, and posted here for the team. One bug per report, please.",
    "button_label": "Report a bug",
    "button_style": "danger"
  },

  "pages": [
    {
      "name": "The bug",
      "title": "Bug Report (1/3): The bug",
      "fields": [
        {"key": "area", "type": "select", "tag": true, "label": "Area of the site",
         "options": ["Marketplace", "Trading", "Chrome Extension", "Database", "Account", "Other"]},
        {"key": "summary", "label": "Short description", "max_length": 60,
         "description": "Keep it short. This is the headline of your post.",
         "placeholder": "e.g. Float values overlap item names on Steam inventory"},
        {"key": "description", "label": "Description of the bug", "style": "paragraph", "max_length": 1000,
         "placeholder": "e.g. On my Steam inventory page, the float values cover the item names"},
        {"key": "steps", "label": "Steps to reproduce", "style": "paragraph", "max_length": 1000,
         "placeholder": "e.g. 1. Open your Steam inventory\n2. Turn on float display\n3. Scroll down"},
        {"key": "expected_actual", "label": "Expected vs. actual behavior", "style": "paragraph", "max_length": 800,
         "placeholder": "e.g. Expected: floats show under the names\nActual: floats cover the names"}
      ]
    },
    {
      "name": "Your setup",
      "title": "Bug Report (2/3): Your setup",
      "fields": [
        {"key": "platform", "type": "select", "label": "Platform",
         "options": ["Web Desktop", "Web Mobile", "Mobile App"]},
        {"key": "browser_os", "label": "Browser & OS", "max_length": 100,
         "placeholder": "e.g. Chrome 141, Windows 11"},
        {"key": "version", "label": "Browser/app version", "max_length": 100, "required": false,
         "placeholder": "e.g. 155.0.8059.85 (Official Build) (64-bit)"},
        {"key": "steam_link", "label": "Steam profile link (optional)", "max_length": 200, "required": false,
         "placeholder": "e.g. https://steamcommunity.com/id/..."},
        {"key": "trade_ref", "label": "Trade ID or item float (optional)", "max_length": 100, "required": false,
         "description": "Leave empty if it doesn't apply.",
         "placeholder": "e.g. Trade 12345678 or float 0.07123"}
      ]
    },
    {
      "name": "Screenshots",
      "title": "Bug Report (3/3): Screenshots",
      "fields": [
        {"key": "category", "type": "select", "tag": true, "label": "Category (optional)", "required": false, "max": 2,
         "placeholder": "Pick up to 2, or skip",
         "options": ["UI/UX", "Performance", "Functionality"]},
        {"type": "note",
         "text": "### Got a screenshot or recording?\nIt's the fastest way for us to see the bug. **Not required.** Leave it empty and press **Submit** to post without one."},
        {"key": "evidence", "type": "file", "label": "Screenshots or recording (optional)", "required": false, "max": 10}
      ]
    }
  ],

  "header": ["area", "category"],
  "style": "text",
  "thumbnail": false,
  "banner": "bug",
  "icon": "mm_bug",
  "card_title": "{summary}",
  "sections": [
    {"heading": "Description", "body": "> {description}"},
    {"heading": "Steps to reproduce", "body": "> {steps}"},
    {"heading": "Expected vs. actual", "body": "> {expected_actual}"},
    {"heading": "Setup", "body": "> **Platform:** {platform}\n> **Browser & OS:** {browser_os}\n> **Version:** {version}", "divider": true},
    {"heading": "Account & trade", "body": "> **Trade ID / float:** {trade_ref}"}
  ],
  "link_button": {"key": "steam_link", "label": "Steam profile"},
  "credit": "Reported by",

  "statuses": ["Open", "In progress", "Fixed", "Not A Bug", "Duplicate", "Closed"],
  "final_statuses": ["Fixed", "Denied", "Duplicate", "Closed"],
  "tag_emojis": {
    "Bug": "🐞",
    "Open": "🔵", "In progress": "🟡", "Fixed": "🟢", "Not A Bug": "❌", "Duplicate": "⚪", "Closed": "⚫"
  },
  "reactions": []
}
